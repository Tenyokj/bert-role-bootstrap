pragma solidity ^0.8.28;

import "@openzeppelin/contracts/access/Ownable.sol";
import "./IRoles.sol";

/**
 * @title RoleBootstrapDistributor
 * @notice One-time allowlisted self-claim distributor for initial BERT user roles
 * @dev This contract must be granted AUTO_GRANT_ROLE in RolesRegistry before claims can succeed
 * @dev Intended for operational bootstrap only, not for permanent protocol usage
 */
contract RoleBootstrapDistributor is Ownable {
    /// @notice Roles registry used by BERT V2
    IRoles public immutable roles;

    /// @notice Last timestamp when claiming is allowed. Zero means no deadline.
    uint64 public immutable claimDeadline;

    /// @notice Whether self-claiming is still enabled
    bool public distributionActive = true;

    /// @dev Tracks addresses eligible to claim curator bootstrap role
    mapping(address => bool) private _curatorEligible;

    /// @dev Tracks addresses eligible to claim reviewer bootstrap role
    mapping(address => bool) private _reviewerEligible;

    /// @dev Tracks whether an address already claimed curator through this distributor
    mapping(address => bool) private _curatorClaimed;

    /// @dev Tracks whether an address already claimed reviewer through this distributor
    mapping(address => bool) private _reviewerClaimed;

    event CuratorEligibilitySeeded(address indexed account);
    event ReviewerEligibilitySeeded(address indexed account);
    event CuratorRoleClaimed(address indexed account);
    event ReviewerRoleClaimed(address indexed account);
    event DistributionClosed(address indexed closedBy);

    error ZeroAddress(string field);
    error DistributionClosedError();
    error ClaimWindowExpired(uint64 deadline);
    error EmptyBatch();
    error NotEligible(address account, bytes32 role);
    error AlreadyClaimed(address account, bytes32 role);
    error AlreadyHasProtocolRole(address account, bytes32 role);

    /**
     * @param owner_ Address that can seed allowlists and close distribution
     * @param rolesRegistry_ Address of the deployed BERT RolesRegistry
     * @param claimDeadline_ Unix timestamp claim deadline, or zero to disable deadline checks
     */
    constructor(address owner_, address rolesRegistry_, uint64 claimDeadline_) Ownable(owner_) {
        if (owner_ == address(0)) {
            revert ZeroAddress("owner");
        }
        if (rolesRegistry_ == address(0)) {
            revert ZeroAddress("rolesRegistry");
        }

        roles = IRoles(rolesRegistry_);
        claimDeadline = claimDeadline_;
    }

    /**
     * @notice Seeds curator role eligibility in batch
     * @dev Safe to call multiple times; already-eligible addresses are skipped
     * @param accounts Eligible curator addresses
     */
    function seedCuratorEligibility(address[] calldata accounts) external onlyOwner {
        _ensureDistributionActive();
        _seedEligibility(accounts, true);
    }

    /**
     * @notice Seeds reviewer role eligibility in batch
     * @dev Safe to call multiple times; already-eligible addresses are skipped
     * @param accounts Eligible reviewer addresses
     */
    function seedReviewerEligibility(address[] calldata accounts) external onlyOwner {
        _ensureDistributionActive();
        _seedEligibility(accounts, false);
    }

    /**
     * @notice Claims CURATOR_ROLE for the caller if allowlisted
     */
    function claimCuratorRole() external {
        _claimCurator(msg.sender);
    }

    /**
     * @notice Claims REVIEWER_ROLE for the caller if allowlisted
     */
    function claimReviewerRole() external {
        _claimReviewer(msg.sender);
    }

    /**
     * @notice Claims every bootstrap role the caller is still eligible for
     * @dev Reverts when caller is not eligible for any unclaimed role
     */
    function claimAllEligibleRoles() external {
        _ensureDistributionActive();

        bool canClaimCurator = _curatorEligible[msg.sender] && !_curatorClaimed[msg.sender];
        bool canClaimReviewer = _reviewerEligible[msg.sender] && !_reviewerClaimed[msg.sender];

        if (!canClaimCurator && !canClaimReviewer) {
            revert NotEligible(msg.sender, bytes32(0));
        }

        if (canClaimCurator) {
            _claimCurator(msg.sender);
        }
        if (canClaimReviewer) {
            _claimReviewer(msg.sender);
        }
    }

    /**
     * @notice Permanently closes the bootstrap distribution
     * @dev After this call, no more claims or allowlist updates are possible
     */
    function closeDistribution() external onlyOwner {
        _ensureDistributionActive();
        distributionActive = false;
        emit DistributionClosed(msg.sender);
    }

    /**
     * @notice Returns whether account is eligible for curator bootstrap
     */
    function isCuratorEligible(address account) external view returns (bool) {
        return _curatorEligible[account];
    }

    /**
     * @notice Returns whether account is eligible for reviewer bootstrap
     */
    function isReviewerEligible(address account) external view returns (bool) {
        return _reviewerEligible[account];
    }

    /**
     * @notice Returns whether account already claimed curator through this contract
     */
    function hasClaimedCurator(address account) external view returns (bool) {
        return _curatorClaimed[account];
    }

    /**
     * @notice Returns whether account already claimed reviewer through this contract
     */
    function hasClaimedReviewer(address account) external view returns (bool) {
        return _reviewerClaimed[account];
    }

    function _seedEligibility(address[] calldata accounts, bool curatorBatch) internal {
        uint256 length = accounts.length;
        if (length == 0) {
            revert EmptyBatch();
        }

        for (uint256 i = 0; i < length; i++) {
            address account = accounts[i];
            if (account == address(0)) {
                revert ZeroAddress("account");
            }

            if (curatorBatch) {
                if (!_curatorEligible[account]) {
                    _curatorEligible[account] = true;
                    emit CuratorEligibilitySeeded(account);
                }
            } else {
                if (!_reviewerEligible[account]) {
                    _reviewerEligible[account] = true;
                    emit ReviewerEligibilitySeeded(account);
                }
            }
        }
    }

    function _claimCurator(address account) internal {
        _ensureDistributionActive();

        bytes32 curatorRole = roles.CURATOR_ROLE();
        if (!_curatorEligible[account]) {
            revert NotEligible(account, curatorRole);
        }
        if (_curatorClaimed[account]) {
            revert AlreadyClaimed(account, curatorRole);
        }
        if (roles.hasRole(curatorRole, account)) {
            revert AlreadyHasProtocolRole(account, curatorRole);
        }

        _curatorClaimed[account] = true;
        roles.grantUserRole(curatorRole, account);
        emit CuratorRoleClaimed(account);
    }

    function _claimReviewer(address account) internal {
        _ensureDistributionActive();

        bytes32 reviewerRole = roles.REVIEWER_ROLE();
        if (!_reviewerEligible[account]) {
            revert NotEligible(account, reviewerRole);
        }
        if (_reviewerClaimed[account]) {
            revert AlreadyClaimed(account, reviewerRole);
        }
        if (roles.hasRole(reviewerRole, account)) {
            revert AlreadyHasProtocolRole(account, reviewerRole);
        }

        _reviewerClaimed[account] = true;
        roles.grantUserRole(reviewerRole, account);
        emit ReviewerRoleClaimed(account);
    }

    function _ensureDistributionActive() internal view {
        if (!distributionActive) {
            revert DistributionClosedError();
        }
        if (claimDeadline != 0 && block.timestamp > claimDeadline) {
            revert ClaimWindowExpired(claimDeadline);
        }
    }
}
